{
  "name": "axi",
  "version": "0.2.0",
  "private": true,
  "description": "axi — fullstack's flow state",
  "author": "Tamas Vince <nemvince@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nemvince/axi.git"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "catalog": {
    "bun": "^1.3.14",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "scripts": {
    "dev:basic": "bun run --filter @axi/basic-example dev",
    "dev:www": "bun run --filter @axi/www dev",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}