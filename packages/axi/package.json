{
  "name": "@axi/core",
  "version": "0.3.10",
  "description": "axi — fullstack's flow state",
  "author": "Tamas Vince <nemvince@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nemvince/axi.git",
    "directory": "packages/axi"
  },
  "bugs": {
    "url": "https://github.com/nemvince/axi/issues"
  },
  "homepage": "https://github.com/nemvince/axi#readme",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "bin": {
    "axi": "./bin/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./client/hydrate": {
      "types": "./src/client/hydrate.tsx",
      "import": "./src/client/hydrate.tsx"
    },
    "./theme": {
      "types": "./src/theme.tsx",
      "import": "./src/theme.tsx"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "bun",
    "framework",
    "react",
    "ssr",
    "websocket",
    "api",
    "fullstack",
    "next",
    "routing"
  ],
  "dependencies": {
    "bun": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}